{
  "name": "@aegispulse/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Ingestion Service \u2014 webhooks, connectors, transaction intake (\u00a72.4\u2013\u00a72.6). Phase 1e: skeleton (config, logs, traces, probes).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @aegispulse/ts-platform/telemetry/register dist/main.js",
    "test": "vitest run --dir src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "vitest run --dir tests/integration --testTimeout=60000"
  },
  "dependencies": {
    "@aegispulse/contracts": "workspace:*",
    "@aegispulse/ts-platform": "workspace:*",
    "@aws-sdk/client-s3": "3.1175.0",
    "ioredis": "6.1.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "3.1.1"
  }
}
