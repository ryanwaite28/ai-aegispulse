{
  "name": "@aegispulse/events",
  "version": "0.1.0",
  "private": true,
  "description": "Events Service \u2014 archive, classification, replay, dead letters (\u00a72.9\u2013\u00a72.11, \u00a72.15). Phase 1e: skeleton (config, logs, traces, probes).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate:mongo": "migrate-mongo up -f src/db/migrate-mongo-config.cjs",
    "migrate:mongo:status": "migrate-mongo status -f src/db/migrate-mongo-config.cjs",
    "start": "node --import @aegispulse/ts-platform/telemetry/register dist/main.js",
    "test": "vitest run --dir src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aegispulse/contracts": "workspace:*",
    "@aegispulse/ts-platform": "workspace:*",
    "@aws-sdk/client-s3": "3.1175.0",
    "migrate-mongo": "14.0.7",
    "mongodb": "7.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
