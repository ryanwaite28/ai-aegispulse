{
  "name": "@aegispulse/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrator \u2014 saga use cases; no datastore; typed clients only (\u00a74.4). Phase 1e: skeleton (config, logs, traces, probes).",
  "type": "module",
  "scripts": {
