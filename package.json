{
  "name": "aegispulse",
  "private": true,
  "version": "0.0.0",
  "description": "AegisPulse monorepo root (Node workspaces). See PROJECT.md.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @aegispulse/ts-platform run build && pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
