    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aegispulse/contracts": "workspace:*",
    "@aegispulse/ts-platform": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
