{
  "name": "@aegispulse/scheduler-trigger",
  "version": "0.1.0",
  "private": true,
  "description": "Node CLI for CronJobs: obtains a SERVICE token, calls ONE internal action, exits (no datastore; §5.1, §6.1).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @aegispulse/ts-platform/telemetry/register dist/main.js",
