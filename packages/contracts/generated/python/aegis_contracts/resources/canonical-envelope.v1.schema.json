{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegispulse.dev/contracts/envelope/canonical-envelope.v1.schema.json",
  "title": "CanonicalEnvelope",
  "description": "AegisPulse canonical event envelope, schemaVersion 1.x (PROJECT.md §6.4). Consumers accept any 1.x and ignore unknown top-level fields only within `payload`; envelope fields are closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "correlationId",
    "causationId",
    "tenantId",
    "schemaVersion",
    "eventType",
    "source",
    "producer",
    "occurredAt",
    "ingestedAt",
    "idempotencyKey",
    "classification",
    "payload"
  ],
  "properties": {
    "eventId": {
      "$ref": "#/$defs/uuid",
      "description": "UUIDv7 from the producer, or deterministic UUIDv5 for storeless producers."
    },
    "correlationId": {
      "type": "string",
      "pattern": "^corr-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "causationId": {
      "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }],
      "description": "eventId of the message that directly caused this one; null for roots."
    },
    "tenantId": {
      "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }],
      "description": "Tenant UUID; null only for platform-level events (ops.*, some intel.*)."
    },
    "tenantSlug": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$", "description": "Informational only." },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z_]+)+$",
      "description": "Equals the routing key (PROJECT.md §6.7)."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Origin, e.g. webhook:{sourceKey}, connector:{key}, api:{route}, service:{name}."
    },
    "producer": {
      "type": "string",
      "pattern": "^aegispulse-[a-z-]+@[0-9a-f]{7,40}$",
      "description": "{runtime}@{git short sha}."
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "ingestedAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "classification": { "$ref": "#/$defs/classification" },
    "payload": {
      "type": "object",
      "description": "Event-specific body, schema per eventType in packages/contracts/events/. ≤ 64 KiB serialized; never binary data."
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "sensitivity": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "UNCLASSIFIED"] },
    "category": { "type": "string", "enum": ["PII", "MNPI", "REGULATORY", "FINANCIAL", "SECRET"] },
    "classificationStatus": {
      "type": "string",
      "enum": ["INGESTED", "RULE_SCANNED", "AI_SCANNED", "CLASSIFIED", "OVERRIDDEN", "ARCHIVED", "REPLAYED"]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity", "status"],
      "properties": {
        "sensitivity": { "$ref": "#/$defs/sensitivity" },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" }, "uniqueItems": true },
        "publisher_stated_severity": { "oneOf": [{ "$ref": "#/$defs/severity" }, { "type": "null" }] },
        "algorithm_severity": { "$ref": "#/$defs/severity" },
        "algorithm_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "final_severity": { "$ref": "#/$defs/severity" },
        "classification_source": { "type": "string", "enum": ["PRODUCER", "RULES", "AI_SCANNER", "ANALYST"] },
        "rule_version": { "type": "string" },
        "classifier_version": { "type": "string" },
        "status": { "$ref": "#/$defs/classificationStatus" }
      }
    }
  }
}
