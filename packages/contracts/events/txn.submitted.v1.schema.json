{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegispulse.dev/contracts/events/txn.submitted.v1.schema.json",
  "title": "txn.submitted payload (v1)",
  "description": "Transaction accepted by ingestion (transaction_submissions + outbox, atomic). Consumed by the ScoreTransactionSaga. Producer: ingestion. Exchange: aegispulse.ingress. FRs: FR-TXN-01, FR-TXN-03. Describes only the envelope `payload` (PROJECT.md §6.4, §6.7); consumers ignore unknown fields (NFR-13).",
  "type": "object",
  "required": [
    "transactionId",
    "accountId",
    "counterpartyId",
    "counterpartyName",
    "amount",
    "currency",
    "country",
    "channel",
    "occurredAt"
  ],
  "properties": {
    "transactionId": {
      "$ref": "../envelope/canonical-envelope.v1.schema.json#/$defs/uuid"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "counterpartyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "counterpartyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]{1,14}\\.[0-9]{2,4}$|^[0-9]{1,18}$",
      "description": "Decimal string, > 0, ≤ 18 digits, 2–4 decimals (FR-TXN-01); sent as a string to avoid float loss."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "channel": {
      "type": "string",
      "enum": ["WIRE", "ACH", "CARD", "CRYPTO", "INTERNAL"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Caller metadata, ≤ 4 KiB (FR-TXN-01); e.g. demoScenario (§1.4.4)."
    },
    "sourceFileId": {
      "$ref": "../envelope/canonical-envelope.v1.schema.json#/$defs/uuid",
      "description": "Batch rows only (transaction_submissions.source_file_id)."
    },
    "sourceRow": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
